<?php
declare(strict_types=1);
/**
 * MIGRATED FILE MAPPING
 * ---------------------
 * Original Old File: db/db.php.example
 * Migrated Date: 2026-08-05 11:55:00
 */

// db/db.php - Database connection template with structured JSON error handling & logging
// Copy this file to db.php and populate with your credentials.

// Define dynamic base path for portable redirects, links, and asset paths
if (!defined('BASE_PATH')) {
    $docRoot = isset($_SERVER['DOCUMENT_ROOT']) && is_string($_SERVER['DOCUMENT_ROOT']) ? rtrim(str_replace('\\', '/', $_SERVER['DOCUMENT_ROOT']), '/') : '';
    $projectRoot = rtrim(str_replace('\\', '/', dirname(__DIR__)), '/');
    $basePath = $docRoot !== '' ? str_replace($docRoot, '', $projectRoot) : '';
    define('BASE_PATH', $basePath);
}

$host    = '127.0.0.1';
$db      = '';
$user    = '';
$pass    = '';
$charset = 'utf8mb4';

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";
/** @var array<int, mixed> $options */
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false,
];

// Ensure a secure logs directory exists
$logDir = __DIR__ . '/../logs';
if (!is_dir($logDir)) {
    mkdir($logDir, 0755, true);
}

// Global Exception Handler
set_exception_handler(function ($exception) use ($logDir): void {
    $errorData = [
        "timestamp"   => gmdate('Y-m-d\TH:i:s\Z'),
        "error_type"  => get_class($exception),
        "message"     => $exception->getMessage(),
        "file"        => $exception->getFile(),
        "line"        => $exception->getLine(),
        "request_uri" => isset($_SERVER['REQUEST_URI']) && is_string($_SERVER['REQUEST_URI']) ? $_SERVER['REQUEST_URI'] : 'CLI/Unknown',
        "method"      => isset($_SERVER['REQUEST_METHOD']) && is_string($_SERVER['REQUEST_METHOD']) ? $_SERVER['REQUEST_METHOD'] : 'UNKNOWN',
        "ip"          => isset($_SERVER['REMOTE_ADDR']) && is_string($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : '127.0.0.1'
    ];

    $logLine = json_encode($errorData) . PHP_EOL;
    if (is_string($logLine)) {
        error_log($logLine, 3, $logDir . '/error_structured.log');
    }

    if (!headers_sent()) {
        http_response_code(500);
    }
    
    $jsonPretty = json_encode($errorData, JSON_PRETTY_PRINT);
    $prettyPrintStr = is_string($jsonPretty) ? $jsonPretty : '{}';
    $basePathVal = defined('BASE_PATH') && is_string(BASE_PATH) ? BASE_PATH : '';
    ?>
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>System Error</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light d-flex align-items-center justify-content-center min-vh-100">
        <div class="container" style="max-width: 600px;">
            <div class="card border-0 shadow-sm p-4 bg-white" role="alert">
                <h2 class="h4 fw-bold text-danger mb-3">⚠️ An Unexpected Error Occurred</h2>
                <p class="text-secondary small">The system encountered an unhandled exception and has safely halted execution.</p>
                <p class="text-secondary small mb-2"><em>If you are debugging this with your AI collaborator, please provide the following structured error snippet:</em></p>
                <pre class="bg-light p-3 rounded small text-dark border overflow-auto mb-4" style="max-height: 200px;"><code><?= htmlspecialchars($prettyPrintStr, ENT_QUOTES, 'UTF-8') ?></code></pre>
                <div>
                    <a href="<?= htmlspecialchars($basePathVal, ENT_QUOTES, 'UTF-8') ?>/index.php" class="btn btn-primary btn-sm px-4 fw-bold text-decoration-none">Return to Public Home</a>
                </div>
            </div>
        </div>
    </body>
    </html>
    <?php
    exit;
});

// Catch fatal errors
register_shutdown_function(function () use ($logDir): void {
    $error = error_get_last();
    if ($error !== null && in_array($error['type'], [E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR], true)) {
        $errorData = [
            "timestamp"   => gmdate('Y-m-d\TH:i:s\Z'),
            "error_type"  => "FatalError_" . $error['type'],
            "message"     => $error['message'],
            "file"        => $error['file'],
            "line"        => $error['line'],
            "request_uri" => isset($_SERVER['REQUEST_URI']) && is_string($_SERVER['REQUEST_URI']) ? $_SERVER['REQUEST_URI'] : 'CLI/Unknown',
            "method"      => isset($_SERVER['REQUEST_METHOD']) && is_string($_SERVER['REQUEST_METHOD']) ? $_SERVER['REQUEST_METHOD'] : 'UNKNOWN',
            "ip"          => isset($_SERVER['REMOTE_ADDR']) && is_string($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : '127.0.0.1'
        ];

        $logLine = json_encode($errorData) . PHP_EOL;
        if (is_string($logLine)) {
            error_log($logLine, 3, $logDir . '/error_structured.log');
        }

        if (!headers_sent()) {
            http_response_code(500);
            $jsonPretty = json_encode($errorData, JSON_PRETTY_PRINT);
            $prettyPrintStr = is_string($jsonPretty) ? $jsonPretty : '{}';
            $basePathVal = defined('BASE_PATH') && is_string(BASE_PATH) ? BASE_PATH : '';
            ?>
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <title>System Error</title>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            </head>
            <body class="bg-light d-flex align-items-center justify-content-center min-vh-100">
                <div class="container" style="max-width: 600px;">
                    <div class="card border-0 shadow-sm p-4 bg-white" role="alert">
                        <h2 class="h4 fw-bold text-danger mb-3">⚠️ A Critical System Error Occurred</h2>
                        <p class="text-secondary small">The system encountered a fatal error and has safely halted execution.</p>
                        <p class="text-secondary small mb-2"><em>If you are debugging this with your AI collaborator, please provide the following structured error snippet:</em></p>
                        <pre class="bg-light p-3 rounded small text-dark border overflow-auto mb-4" style="max-height: 200px;"><code><?= htmlspecialchars($prettyPrintStr, ENT_QUOTES, 'UTF-8') ?></code></pre>
                        <div>
                            <a href="<?= htmlspecialchars($basePathVal, ENT_QUOTES, 'UTF-8') ?>/index.php" class="btn btn-primary btn-sm px-4 fw-bold text-decoration-none">Return to Public Home</a>
                        </div>
                    </div>
                </div>
            </body>
            </html>
            <?php
        }
        exit;
    }
});

try {
    $pdo = new PDO($dsn, $user, $pass, $options);

    // Include and execute the global maintenance guard
    require_once __DIR__ . '/maintenance_guard.php';
    check_maintenance_mode($pdo);
} catch (\PDOException $e) {
    throw new \PDOException("Database Connection Failed: " . $e->getMessage(), (int)$e->getCode());
}
