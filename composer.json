{
    "name": "deballiol/prd",
    "description": "PRD MVC application",
    "type": "project",
    "require": {
        "php": "^8.2",
        "nesbot/carbon": "^3.13",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
