{
    "name": "deballiol/prd",
    "description": "PRD MVC application",
    "type": "project",
    "require": {
        "php": "^8.2",
        "nesbot/carbon": "^3.13",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "lang:audit": "php scripts/langSortUtility/check_translations.php",
        "lang:check-list": "php scripts/langSortUtility/audit_lang.php",
        "lang:sort": "php scripts/langSortUtility/sort_lang_blocks.php",
        "lang:counts": "php scripts/langSortUtility/check_counts.php",
        "lang:missing": "php scripts/langSortUtility/check_missing_keys.php",
        "lang:duplicates": "php scripts/langSortUtility/find_duplicate_keys.php",
        "pretty": "php scripts/langSortUtility/lang_file_pretty.php",
        "deadkeys": "php scripts/langSortUtility/dead_language_keys.php"
    },
    "config": {
        "sort-packages": true
    }
}
